{
  "name": "e-estimate",
  "version": "0.1.7",
  "description": "E-Estimate \u2014 construction cost estimation desktop app for Telangana SOR/SSR",
  "main": "./out/main/index.js",
  "author": "E-Estimate",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "publish:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "test": "npm run test:lead && npm run test:data-variants && npm run test:rate-analysis && npm run test:charts && npm run test:project-items && npm run test:guide-wall && npm run test:bund && npm run test:bund-new && npm run test:bund-figures && npm run test:bund-materials && npm run test:seigniorage-permit && npm run test:project-abstract && npm run test:smart-abstract && npm run test:tree-reorder && npm run test:print-columns && npm run test:seig-print-layout && npm run test:pinned-pages && npm run test:project-vpv && npm run test:export-pdf && npm run test:document-final && npm run test:print-description && npm run test:signatures",
    "test:smart-abstract": "node scripts/test-smart-abstract.cjs",
    "test:signatures": "node scripts/test-signature-footer.cjs",
    "test:print-description": "node scripts/test-print-description.cjs",
    "test:document-final": "node scripts/test-document-final.cjs",
    "test:pinned-pages": "node scripts/test-pinned-pages.cjs",
    "test:project-vpv": "node scripts/test-project-vpv.cjs",
    "test:export-pdf": "node scripts/test-export-pdf.cjs",
    "test:seig-print-layout": "node scripts/test-seigniorage-print-layout.cjs",
    "test:tree-reorder": "node scripts/test-tree-reorder.cjs",
    "test:print-columns": "node scripts/test-print-columns.cjs",
    "test:seigniorage-permit": "node scripts/test-seigniorage-permit.cjs",
    "test:project-abstract": "node scripts/test-project-abstract.cjs",
    "test:lead": "node scripts/test-lead.cjs",
    "test:data-variants": "node scripts/test-data-variants.cjs",
    "test:rate-analysis": "node scripts/test-rate-analysis.cjs",
    "test:charts": "node scripts/test-chart-data.cjs",
    "test:project-items": "node scripts/test-project-items.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:guide-wall": "node scripts/test-guide-wall.cjs",
    "test:bund": "node scripts/test-bund.cjs",
    "test:bund-new": "node scripts/test-bund-new.cjs",
    "test:bund-figures": "node scripts/test-bund-figures.cjs",
    "test:bund-materials": "node scripts/test-bund-materials.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@univerjs/core": "^0.25.0",
    "@univerjs/preset-docs-core": "^0.25.0",
    "@univerjs/preset-docs-drawing": "^0.25.0",
    "@univerjs/preset-sheets-core": "^0.25.0",
    "@univerjs/preset-sheets-drawing": "^0.25.0",
    "chart.js": "^4.4.4",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.451.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "rxjs": "^7.8.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
